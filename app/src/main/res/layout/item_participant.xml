<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF"
    app:cardBackgroundColor="#33FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris atas: info peserta (kiri) + tombol Lihat Review (kanan) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Info peserta -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toStartOf="@id/btnReview"
                android:layout_alignParentStart="true">

                <!-- Ganti bagian TextView Nama Peserta dengan ini -->
                <TextView
                    android:id="@+id/tvParticipantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Peserta"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00FFFF"/> <!-- Warna Biru Neon -->

                <TextView
                    android:id="@+id/tvParticipantRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mahasiswa"
                    android:textSize="14sp"
                    android:textColor="#CCCCCC"/>

                <TextView
                    android:id="@+id/tvParticipantStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PENDING"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"/>
            </LinearLayout>

            <!-- Tombol Lihat Review (Gaya Outline Neon Jingga) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReview"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Lihat Review"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"
                app:backgroundTint="#33FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#F59E0B"
                app:cornerRadius="10dp"
                android:visibility="gone"/>
        </RelativeLayout>

        <!-- Tombol aksi bawah -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Tombol Lihat Bukti (Biru Neon) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewProof"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Bukti"
                android:textStyle="bold"
                app:backgroundTint="#33FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#00FFFF"
                app:cornerRadius="10dp"/>

            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

            <!-- Tombol Approve (Hijau Neon) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Approve"
                android:textStyle="bold"
                app:backgroundTint="#33FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#00BFA5"
                app:cornerRadius="10dp"
                android:visibility="gone"/>

            <Space android:id="@+id/spaceApprove" android:layout_width="8dp" android:layout_height="wrap_content" android:visibility="gone"/>

            <!-- Tombol Reject (Merah Neon) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Reject"
                android:textStyle="bold"
                app:backgroundTint="#33FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#FF5252"
                app:cornerRadius="10dp"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>