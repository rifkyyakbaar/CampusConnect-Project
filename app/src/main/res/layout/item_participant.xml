<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#20FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nama -->
        <TextView
            android:id="@+id/tvParticipantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Peserta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <!-- Role -->
        <TextView
            android:id="@+id/tvParticipantRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mahasiswa"
            android:textSize="14sp"
            android:textColor="#B0B0B0"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvParticipantStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PENDING"
            android:textStyle="bold"
            android:textColor="#F59E0B"/>

        <!-- Tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnViewProof"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#30FFFFFF"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:text="Bukti"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/warna_primer"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:text="Approve"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#20DC2626"
                android:textColor="#DC2626"
                android:textAllCaps="false"
                android:text="Reject"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>