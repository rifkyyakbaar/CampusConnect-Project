<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_utama">

    <LinearLayout
        android:id="@+id/headerVerify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header_admin"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackVerify"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Event Verification"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerVerify"
        app:layout_constraintBottom_toTopOf="@id/bottomVerifyBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submitted by Organizer:"
                android:textColor="@color/teks_sekunder"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvVerifyOrganizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEM Fakultas Teknik"
                android:textColor="@color/teks_utama"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <!-- Placeholder untuk preview data event (Judul, Kapasitas, dll) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Title"
                android:textColor="#6B7280"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvVerifyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workshop Web Development"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description Preview"
                android:textColor="#6B7280"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvVerifyDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workshop ini ditujukan untuk pemula yang ingin belajar..."
                android:textColor="#111827"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bar Aksi (Approve/Reject) -->
    <LinearLayout
        android:id="@+id/bottomVerifyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/bg_utama"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/bg_tolak"
            android:text="Reject"
            android:textAllCaps="false"
            android:textColor="@color/teks_tolak"
            app:cornerRadius="10dp"
            app:strokeColor="@color/teks_tolak"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnApprove"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/bg_terima"
            android:text="Approve"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="10dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>