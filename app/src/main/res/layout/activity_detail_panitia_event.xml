<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_utama"
    tools:context=".ui.mahasiswa.DetailEventActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/ivDetailPoster"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:background="@color/bg_input" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPETITION"
                        android:textColor="@color/warna_primer"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Oct 24, 2026"
                        android:textColor="@color/teks_sekunder"
                        android:textSize="12sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Annual Inter-University Hackathon: CodeTheFuture"
                    android:textColor="@color/teks_utama"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="@color/teks_sekunder"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvDetailLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Main Auditorium, Building A"
                        android:textColor="@color/teks_sekunder"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/garis_pembatas"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About This Event"
                    android:textColor="@color/teks_utama"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Join over 500 developers for 48 hours of building, learning, and networking. This annual hackathon brings together the brightest minds across universities to solve real-world problems using technology. \n\nWhat to expect:\n- Mentorship from industry experts\n- Free food and swags\n- Grand prize of $5000"
                    android:textColor="@color/teks_sekunder"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/bg_utama"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tickets Left"
                    android:textColor="@color/teks_sekunder"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvTicketsLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100 / 500"
                    android:textColor="@color/teks_warning"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnManageParticipants"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Manage Participants"
            android:textAllCaps="false"
            android:backgroundTint="@color/warna_primer"
            android:textColor="@color/white"
            app:cornerRadius="10dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

        <Button
            android:id="@+id/btnScanTicket"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Scan Ticket"
            android:textAllCaps="false"
            android:backgroundTint="@color/warna_warning"
            android:textColor="@color/white"
            app:cornerRadius="10dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>